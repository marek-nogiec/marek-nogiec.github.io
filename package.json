{
  "name": "marek-nogiec.github.io",
  "private": true,
  "version": "0.0.0",
  "description": "Personal homepage, served via GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <26",
    "npm": ">=10.9.0 <12"
  },
  "packageManager": "npm@10.9.4",
  "browserslist": [
    "Chrome >= 123",
    "Edge >= 123",
    "Firefox >= 120",
    "Safari >= 17.5"
  ],
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "node --test scripts/*.test.mjs",
    "verify:browser": "npm run build && node scripts/verify-browser.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify": "rsbuild build && node scripts/verify-dist.mjs && npm test"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.7"
  }
}
