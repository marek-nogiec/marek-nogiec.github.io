{
  "name": "marek-nogiec.github.io",
  "private": true,
  "version": "0.0.0",
  "description": "Personal homepage, served via GitHub Pages",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <26",
    "npm": ">=10.9.0 <12"
  },
  "packageManager": "npm@10.9.4",
  "browserslist": [
    "Chrome >= 123",
    "Edge >= 123",
    "Firefox >= 120",
    "Safari >= 17.5"
  ],
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "fonts:build": "python3 scripts/build-font-subset.py",
    "fonts:verify": "python3 scripts/build-font-subset.py --check",
    "test": "node --test scripts/*.test.mjs",
    "verify:browser": "npm run build && node scripts/verify-browser.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify": "npm run fonts:verify && rsbuild build && node scripts/verify-dist.mjs && npm test"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.8"
  }
}
