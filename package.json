{
  "name": "marek-nogiec.github.io",
  "private": true,
  "version": "0.0.0",
  "description": "Personal homepage, served via GitHub Pages",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <26",
    "npm": ">=10.9.0 <12"
  },
  "packageManager": "npm@10.9.4",
  "browserslist": [
    "Chrome >= 123",
    "Edge >= 123",
    "Firefox >= 120",
    "Safari >= 17.5"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "lint:commit": "commitlint --last --verbose",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose",
    "fonts:build": "python3 scripts/build-font-subset.py",
    "fonts:verify": "python3 scripts/build-font-subset.py --check",
    "test": "node --test scripts/*.test.mjs",
    "browser:install": "playwright install --only-shell chromium",
    "verify:browser:built": "playwright test --config playwright.config.mjs",
    "verify:browser": "npm run build && npm run verify:browser:built",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify": "npm run fonts:verify && rsbuild build && node scripts/verify-dist.mjs && npm test",
    "verify:all": "npm run verify && npm run verify:browser:built"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.61.1",
    "@rsbuild/core": "^2.1.8",
    "simple-git-hooks": "2.13.1"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no-install commitlint --edit \"$1\""
  }
}
